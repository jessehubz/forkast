# Supabase — get from: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Prisma / Postgres — get from: Supabase dashboard → Settings → Database → Connection string
# DATABASE_URL: use "Session mode" (port 6543) + append ?pgbouncer=true
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: use "Direct connection" (port 5432) — used by prisma db push and migrations
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"
